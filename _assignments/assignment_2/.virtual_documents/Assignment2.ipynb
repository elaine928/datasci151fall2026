import pandas as pd
import matplotlib.pyplot as plt





# Write your answer
us_emissions = pd.read_csv("data/us_emission.csv")





# Write your answer
columns = ["Year", "Energy_consumption", "CO2_emission", "GDP"]






# Write your answer
us_emissions[columns[2]].describe()





# run this cell to compare with your answer above
us_emissions["CO2_emission"].describe()





# Write your answer
plt.scatter(x = us_emissions['Energy_consumption'], y = us_emissions['CO2_emission'])
plt.xlabel("Energy Consumption")
plt.ylabel("CO2 emission")
plt.title("Relationship between Energy Consumption and CO2 Emission")
plt.show()





# Write your answer
china_emissions = pd.read_csv("data/china_emission.csv")
korea_emissions = pd.read_csv("data/korea_emission.csv")

plt.scatter(china_emissions["Year"], china_emissions["CO2_emission"])
