# your answer here
features = pd.read_csv("data/features.csv")
model = smf.ols(formula = "mpg ~ weight" , data = features)
coeffs = model.fit().params
print(coeffs)







# your answer here
a = float(coeffs['weight'])
b = float(coeffs["Intercept"])

predicted_mpg = a * features["weight"] + b

plt.scatter(x = features["weight"], y = features["mpg"], color = "pink",label="data")

plt.plot(features["weight"], predicted_mpg, color = "red", label="best fit line")
    
# Add labels and a legends    
plt.xlabel("Weight")
plt.ylabel("MPG")
plt.title("Linear Regression: Weight vs MPG")

# Add legend
plt.legend()

# Display the plot
plt.show()
